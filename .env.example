# Project Relay configuration. Every value here is a safe local default.
# Copy to .env to override. .env is git-ignored and must never be committed.

# --- Database -------------------------------------------------------------
# Admin URL: used ONLY by migrations and seeding of the role (owner of the schema).
RELAY_ADMIN_DATABASE_URL=postgresql://postgres:relay@localhost:5432/relay
# App URL: the non-superuser, NOBYPASSRLS role every request and worker uses.
RELAY_DATABASE_URL=postgresql://relay_app:relay_app@localhost:5432/relay
# Password the migration assigns to the relay_app role (local only).
RELAY_APP_DB_PASSWORD=relay_app
# Database the test-suite creates and drops (never the demo database).
RELAY_TEST_DATABASE=relay_test

# --- Models (all local, via Ollama) ----------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
RELAY_TRIAGE_MODEL=qwen2.5:1.5b
RELAY_DRAFT_MODEL=qwen2.5:3b
RELAY_EMBED_MODEL=nomic-embed-text
RELAY_EMBED_DIM=768
RELAY_MODEL_TEMPERATURE=0
RELAY_MODEL_SEED=7
RELAY_MODEL_TIMEOUT_S=120

# --- Budgets (tokens = Ollama prompt_eval_count + eval_count) -------------
RELAY_MAX_TOKENS_PER_TICKET=6000
RELAY_MAX_TOKENS_PER_RUN=200000

# --- Retrieval --------------------------------------------------------------
RELAY_RETRIEVAL_TOP_K=3
# Minimum cosine similarity for a passage to count as evidence.
RELAY_RETRIEVAL_MIN_SCORE=0.5

# --- Queue -------------------------------------------------------------------
# Lease length; a heartbeat extends it every lease/3 while a job runs.
RELAY_LEASE_SECONDS=30
RELAY_MAX_ATTEMPTS=3
RELAY_BACKOFF_BASE_S=2
RELAY_BACKOFF_MAX_S=60

# --- Chaos (stretch S1). 0 disables random gateway failures. --------------
CHAOS_FAIL_RATE=0

# --- API ---------------------------------------------------------------------
RELAY_API_PORT=8077
# Local-development operator identities: token=name@tenant1|tenant2, comma-separated.
# This is NOT enterprise auth; see docs/LIMITATIONS.md.
RELAY_API_TOKENS=dev-operator-token=operator@northwind|harbor
